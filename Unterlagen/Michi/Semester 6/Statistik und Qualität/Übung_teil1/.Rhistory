cpi = c(0, 0, 1, 3, 4, 1, 2, 2, 1, 1, 1, 2, 3, 0, 2, 0, 1, 3, 1, 2, 2, 0, 1, 1, 6, 1, 0, 2, 3, 1, 1, 4, 2, 3, 2, 0, 3, 0, 1, 2) # Calls per interval
mean_val = mean(cpi)
std_dev = sd(cpi)
med = median(cpi)
element_counts = table(cpi)
# Raw input data
cpi.raw <- c(0, 0, 1, 3, 4, 1, 2, 2, 1, 1, 1, 2, 3, 0, 2, 0, 1, 3, 1, 2, 2, 0, 1, 1, 6, 1, 0, 2, 3, 1, 1, 4, 2, 3, 2, 0, 3, 0, 1, 2) # Calls per interval
cpi.len <- length(cpi.raw)
cpi.table <- table(cpi.raw)
# Scale factor for y axis of barplot
scale_factor <-  1.1
# Absolute occurences
cpi.element_counts <- cpi.table
barplot(cpi.element_counts, ylim = c(0,max(cpi.element_counts) * scale_factor), ylab = "Anzahl", xlab = "Telefonate im Intervall von 10 min", main = "Absolute Häufigkeit")
# Relative occurences
cpi.element_frq <- cpi.table/cpi.len
barplot(cpi.element_frq, ylim = c(0,max(cpi.element_frq) * scale_factor), ylab = "Anzahl", xlab = "Telefonate im Intervall von 10 min", main = "Relative Häufigkeit")
# Sum frequency
cpi.cumulated_sum <- cumsum(cpi.table)
barplot(cpi.cumulated_sum, ylim = c(0,(max(cpi.cumulated_sum) * scale_factor)), ylab = "Kumulierte Anzahl", xlab = "Telefonate im Intervall von 10 min", main = "Summenhäufigkeit")
# Position parameters
cpi.modus <- names(cpi.table)[which(cpi.table == max(cpi.table))]
cpi.med <- median(cpi.raw)
cpi.mean_val <- mean(cpi.raw)
# Scattering parameters
summary(cpi.raw)
cpi.min <- min(cpi.raw)
cpi.max <- max(cpi.raw)
cpi.range <- cpi.max - cpi.min
# Quantiles do not care if data length is even or uneven.
cpi.q25 <- sort(cpi.raw)[cpi.len/4]
cpi.q75 <- sort(cpi.raw)[3*cpi.len/4]
cpi.q50 <- sort(cpi.raw)[cpi.len/2]
cpi.std_dev <- sd(cpi.raw)
# Raw input data
cpi.raw <- c(0, 0, 1, 3, 4, 1, 2, 2, 1, 1, 1, 2, 3, 0, 2, 0, 1, 3, 1, 2, 2, 0, 1, 1, 6, 1, 0, 2, 3, 1, 1, 4, 2, 3, 2, 0, 3, 0, 1, 2) # Calls per interval
cpi.len <- length(cpi.raw)
cpi.table <- table(cpi.raw)
# Scale factor for y axis of barplot
scale_factor <-  1.1
# Absolute occurences
cpi.element_counts <- cpi.table
barplot(cpi.element_counts, ylim = c(0,max(cpi.element_counts) * scale_factor), ylab = "Anzahl", xlab = "Telefonate im Intervall von 10 min", main = "Absolute Häufigkeit")
# Relative occurences
cpi.element_frq <- cpi.table/cpi.len
barplot(cpi.element_frq, ylim = c(0,max(cpi.element_frq) * scale_factor), ylab = "Anzahl", xlab = "Telefonate im Intervall von 10 min", main = "Relative Häufigkeit")
# Sum frequency
cpi.cumulated_sum <- cumsum(cpi.table)
barplot(cpi.cumulated_sum, ylim = c(0,(max(cpi.cumulated_sum) * scale_factor)), ylab = "Kumulierte Anzahl", xlab = "Telefonate im Intervall von 10 min", main = "Summenhäufigkeit")
# Position parameters
cpi.modus <- names(cpi.table)[which(cpi.table == max(cpi.table))]
cpi.med <- median(cpi.raw)
cpi.mean_val <- mean(cpi.raw)
# Scattering parameters
cpi.min <- min(cpi.raw)
cpi.max <- max(cpi.raw)
cpi.range <- cpi.max - cpi.min
# Quantiles do not care if data length is even or uneven.
cpi.q25 <- sort(cpi.raw)[cpi.len/4]
cpi.q75 <- sort(cpi.raw)[3*cpi.len/4]
cpi.q50 <- sort(cpi.raw)[cpi.len/2]
cpi.std_dev <- sd(cpi.raw)
# Automated calculation for check
summary(cpi.raw)
