TEXT -1248 -592 Left 2 !.meas TRAN diff_I_L1_id_real PARAM (id_I_L1_avg-I_L1_avg)\n.meas TRAN diff_V_C_id_real PARAM (id_Vout-Vout)\n.meas TRAN diff_delta_I_id_real PARAM (id_Delta_I_L1-Delta_I_L1)\n.meas TRAN diff_delta_V_id_real PARAM (id_Delta_V_R1-Delta_V_R1)
TEXT 552 568 Left 2 !;Power Calculations\n;Efficiency\n.meas TRAN pIn AVG (-V(in)*I(R_I_meas))\n.meas TRAN pOut AVG (V(out)*I(R1))\n.meas TRAN eff PARAM (pOut/pIn)\n \n;MOSFET \n.meas TRAN pow_M1 AVG (V(in)*Ix(M1:D)+V(drv)*Ix(M1:G)+V(sw)*Ix(M1:S))\n \n;Diode\n.meas TRAN pow_D1 AVG (-V(sw)*I(D1))\n \n;Inductor\n.meas TRAN pow_L1 AVG (V(out,L_loss)*I(L1_R_para))\n \n;Capacitor\n.meas TRAN pow_C1 AVG (V(C_loss)*I(C1_R_para))
