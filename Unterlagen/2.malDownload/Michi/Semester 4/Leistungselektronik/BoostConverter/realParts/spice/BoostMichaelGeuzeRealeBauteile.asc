TEXT 1080 -624 Left 2 !;Settings;\n.param R_load 12\n.param Vin 17.2\n.param fsw 200k\n.param T 1/fsw\n.param D 0.5\n.param Vsw 10
TEXT 48 688 Left 2 !.tran 0 {1000*T} {995*T}
TEXT -8 -624 Left 2 !.meas TRAN Vout AVG V(out)\n.meas TRAN maxVout MAX V(out)\n.meas TRAN minVout MIN V(out)\n.meas TRAN Delta_V_R1 PARAM (maxVout-minVout)/2\n.meas TRAN Iout AVG I(R1)\n.meas TRAN I_L1_avg AVG I(L1)\n.meas TRAN maxL1 MAX I(L1)\n.meas TRAN minL1 MIN I(L1)\n.meas TRAN Delta_I_L1 PARAM (maxL1-minL1)/2\n.meas TRAN Delta_I_L1_percent PARAM(Delta_I_L1 * 100 / I_L1_avg )
TEXT 1088 -320 Left 2 !;Real component values\n;Inductance\n.param L1 62.56u\n.param L1_R_para 0.265\n.param L1_C_para 5p ;no info, value is guessed, similar values can be found with similar inductors\n \n;Capacitors\n.param C1 1u\n.param C1_R_para 22.5m; from kemet simulator online
