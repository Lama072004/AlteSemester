TEXT -4776 -920 Left 2 !.MEAS TRAN Ic AVG(Ic(Q2)) from 0.9 to 1\n.MEAS TRAN Ic_ AVG(Ic(Q1)) from 0.9 to 1\n \n.MEAS TRAN Ib AVG(Ib(Q2))\n.MEAS TRAN ube AVG(V(ue1)-V(uEm1))\n.MEAS TRAN ube_ AVG(V(ue2)-V(uEm2))\n.MEAS TRAN beta AVG(Ic(Q2)/Ib(Q2))\n.MEAS TRAN S AVG(Ic(Q2)/0.025)\n.MEAS TRAN S_IcUbe AVG( (Ic(Q2)-Ic(Q3))/( (V(ue1)-V(uEm1)) - (V(ue2)-V(uEm2)) ) )\n.MEAS TRAN rbe_AP AVG(beta/S)\n.MEAS TRAN r_Basis  AVG(beta*(200+(1/S)))\n.MEAS TRAN re AVG(1/((1/16000)+(1/84000)+(1/r_Basis)))\n \n.MEAS TRAN re_ui AVG((V(ue2)-V(ue1))/(I(R2)-I(R5)))\n.MEAS TRAN A AVG(1k/200)\n.MEAS TRAN A_ui AVG((V(ua2)-V(ua1))/(V(ue1)-V(ue2)))\n \n.MEAS TRAN ra AVG((V(ua3)-V(ua4))/(I(RL1)-I(RL2)))\n \n.MEAS TRAN uaMax MAX(V(ua5))\n.MEAS TRAN uaMin MIN(V(ua5))\n.MEAS TRAN uaAmpl AVG(uaMAX-uaMin)\n.MEAS TRAN ueMax MAX(V(ue5))\n.MEAS TRAN ueMin MIN(V(ue5))\n.MEAS TRAN ueAmpl AVG(ueMAX-ueMin)\n.MEAS TRAN A_sin AVG( uaAmpl/ueAmpl) \n.MEAS TRAN ieMax MAX(I(R1))\n.MEAS TRAN ieMin MIN(I(R1))\n.MEAS TRAN ieAmpl AVG(ieMAX-ieMin)\n \n.MEAS TRAN re_sin AVG(ueAmpl/ieAmpl)
